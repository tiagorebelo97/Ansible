# Example Environment Configuration
# Copy this file to .env and update with your values (do not commit .env!)

# Cluster Configuration
CLUSTER_NAME=ocp-cluster
BASE_DOMAIN=example.com
OPENSHIFT_VERSION=4.14

# Network Configuration
CLUSTER_NETWORK_CIDR=10.128.0.0/14
SERVICE_NETWORK=172.30.0.0/16

# Node IPs (update with your actual IPs)
MASTER01_IP=10.0.0.11
MASTER02_IP=10.0.0.12
MASTER03_IP=10.0.0.13
WORKER01_IP=10.0.0.21
WORKER02_IP=10.0.0.22
WORKER03_IP=10.0.0.23
BOOTSTRAP_IP=10.0.0.10

# SSH Configuration
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa.pub

# DNS Servers
DNS_SERVER1=8.8.8.8
DNS_SERVER2=8.8.4.4

# NTP Servers
NTP_SERVER1=0.rhel.pool.ntp.org
NTP_SERVER2=1.rhel.pool.ntp.org

# Registry (if using private registry)
REGISTRY_MIRROR=
REGISTRY_PULL_SECRET_PATH=

# Proxy Settings (if behind proxy)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
