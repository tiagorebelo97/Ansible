apiVersion: v1
baseDomain: {{ base_domain }}
compute:
- hyperthreading: Enabled
  name: worker
  replicas: 3
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: 3
metadata:
  name: {{ cluster_name }}
networking:
  clusterNetwork:
  - cidr: {{ cluster_network_cidr }}
    hostPrefix: {{ cluster_network_host_prefix }}
  networkType: OVNKubernetes
  serviceNetwork:
  - {{ service_network }}
platform:
  none: {}
fips: false
pullSecret: '{{ registry_pull_secret | default("{}") }}'
sshKey: '{{ ssh_public_key }}'
